function markdownToPlainText(mdText) { // convert Markdown to HTML, then strip HTML tags
  const html = marked.parse(mdText);
  let plainText = html.replace(/<[^>]+>/g, ''); // remove HTML tags
  return he.decode(plainText); // some characters need to be decoded back to their original chars due to using marked library
}

const chatWithBotViaTextInput = async (req, res) => {
    const userMessage = req.body.message;
    
    if (!userMessage)
        return res.status(400).json({ error: 'You must send a message!' });

    try {
        let botResponse = await chatWithBot(userMessage);
        botResponse = markdownToPlainText(botResponse);
        res.status(200).json({ response: botResponse });
        console.log("Response: " + botResponse);
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
};

const chatWithBotViaAudioInput = async (req, res) => {
    recording = recorder.record({
        silence: 3, // duration to wait before stopping due to silence (does not work for unknown reasons)
        threshold: 0.07 // mic sensitivity to aid with silence detection
    });

    console.log("Recording was started. Press Ctrl+C to stop.")

    recording.stream().on('stop', () => {
        console.log("Recording stopped due to silence.");
    });
    
    // recording.stream().on('data', (data) => { // debugging to check if mic is receiving any input
    //     console.log(`Received audio chunk of size: ${data.length}`);
    // });

    const client = new TranscribeStreamingClient({
        region: "us-west-2",
        credentials
    });

    const params = {
        LanguageCode,
        MediaEncoding,
        MediaSampleRateHertz,
        AudioStream: (async function* () {
            for await (const chunk of recording.stream()) {
                yield {AudioEvent: {AudioChunk: chunk}};
            }
        })(),
    };

    const command = new StartStreamTranscriptionCommand(params);
    const response = await client.send(command);

    try {
        for await (const event of response.TranscriptResultStream) {
            if (event.TranscriptEvent) {
                const transcripts = event.TranscriptEvent.Transcript.Results;

                for (const result of transcripts) {
                    if (!result.IsPartial) {
                        const transcription = result.Alternatives[0].Transcript; // most accurate transcribed text
                        recording.stop();
                        console.log(`Transcription: ${transcription}`);

                        try { // send the transcription to the chatbot
                            let botResponse = await chatWithBot(transcription);
                            botResponse = markdownToPlainText(botResponse);
                            res.status(200).json({ response: botResponse });
                            console.log("Response: " + botResponse);
                        } catch (error) {
                            console.error("Error communicating with chatbot: ", error);
                        }
                    }
                }
            }
        }
    } catch (err) {
        console.error("Error in transcription stream:", err);
    }
};

